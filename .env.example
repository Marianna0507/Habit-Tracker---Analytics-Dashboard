PORT=3000
DATABASE_URL=postgresql://habit_user:habit_pass@localhost:5433/habit_tracker
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PYTHON_ANALYTICS_URL=http://localhost:8000
# Leave unset locally - local Docker Postgres has no SSL configured.
# Render's managed Postgres requires it; set to 'true' there (see render.yaml).
PGSSL=

# Used by docker-compose.yml for ${ANALYTICS_READER_PASSWORD} substitution -
# must match the password in db/roles/analytics_reader.sql
ANALYTICS_READER_PASSWORD=replace-with-the-role-password
